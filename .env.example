# --- OpenTelemetry export: point this at YOUR SigNoz ---
# Self-hosted SigNoz OTLP endpoints: gRPC :4317  |  HTTP :4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
ROOTCAUSE_OTLP_PROTOCOL=grpc            # grpc (4317) or http (4318)
OTEL_SERVICE_NAME=rootcause-hydro
ROOTCAUSE_ENV=hackathon

# --- Simulation ---
ROOTCAUSE_TICK_SECONDS=5                 # wall-clock seconds per tick
ROOTCAUSE_MINUTES_PER_TICK=10            # simulated minutes advanced per tick
ROOTCAUSE_DOSE_EVERY_TICKS=6            # dosing cycle cadence (~hourly)
ROOTCAUSE_CROP=lettuce
ROOTCAUSE_STAGE=veg                      # seedling | veg | flower
ROOTCAUSE_PHOTOPERIOD=18                 # light hours per 24h

# --- Control plane (fault injection API) ---
ROOTCAUSE_HOST=0.0.0.0
ROOTCAUSE_PORT=8099

# --- SigNoz URL: used by the apply script AND the Mission Control "Open SigNoz" link ---
# For a public deploy, set this to your reachable SigNoz, e.g. http://20.120.242.78:8080
SIGNOZ_URL=http://localhost:8080
# SIGNOZ_API_KEY=            # create under SigNoz Settings -> API Keys. NEVER commit a real key.

# --- Offline / smoke testing (no SigNoz needed) ---
# ROOTCAUSE_CONSOLE=1        # print telemetry to stdout
# ROOTCAUSE_DISABLE_OTLP=1   # skip OTLP export entirely
